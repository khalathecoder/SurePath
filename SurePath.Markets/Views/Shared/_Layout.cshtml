<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — SurePath Markets</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,300;0,400;0,500;1,300&family=Syne:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/markets.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- SCANLINE OVERLAY handled in CSS -->

    <header>
        <div class="logo">
            <div class="logo-badge">SP</div>
            <div class="logo-wrap">
                <span>SurePath Enterprises</span>
                <span class="logo-sub">Markets Division</span>
            </div>
        </div>

        <nav>
            <a asp-controller="Home" asp-action="Index">Home</a>
            <a asp-controller="Trade" asp-action="Journal" class="@(ViewData["ActiveNav"]?.ToString() == "journal" ? "active" : "")">Journal</a>
            <a href="#">Risk Calc</a>
            <a href="#">Analytics</a>
        </nav>

        <div class="header-right">
            <div class="ticker-strip">
                <div class="ticker-item">
                    <span class="ticker-symbol">ES</span>
                    <span class="ticker-price" id="t-es">5,842.25</span>
                    <span class="ticker-change up" id="tc-es">▲ 0.32%</span>
                </div>
                <div class="ticker-item">
                    <span class="ticker-symbol">NQ</span>
                    <span class="ticker-price" id="t-nq">20,712.50</span>
                    <span class="ticker-change dn" id="tc-nq">▼ 0.11%</span>
                </div>
                <div class="ticker-item">
                    <span class="ticker-symbol">CL</span>
                    <span class="ticker-price" id="t-cl">71.43</span>
                    <span class="ticker-change up" id="tc-cl">▲ 0.64%</span>
                </div>
            </div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <div class="status-bar">
        <div class="status-item"><div class="status-dot"></div> Live</div>
        <div class="status-item">SurePath Markets v1.0</div>
        <div class="status-item" id="status-time"></div>
        <div style="margin-left:auto;" class="status-item">markets.surepath.com</div>
    </div>

    <script src="~/js/markets.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>