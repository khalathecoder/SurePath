<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — SurePath</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,300;0,400;0,500;1,300&family=Syne:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/markets.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- SCANLINE OVERLAY handled in CSS -->

    <header>
        <a asp-controller="Home" asp-action="Index" style="text-decoration:none;">
            <div class="logo">
                <div class="logo-badge">SP</div>
                <div class="logo-wrap">
                    <span>SurePath Enterprises</span>
                    @if (ViewData["Division"] != null)
                    {
                        <span class="logo-sub">@ViewData["Division"]</span>
                    }
                </div>
            </div>
        </a>

        <nav>
            <a asp-controller="Trade" asp-action="Analytics">Trading Desk</a>
            <a asp-controller="DevSecurity" asp-action="Index">Dev/Security</a>
            <a asp-controller="ECommerce" asp-action="Index">E-Commerce</a>
        </nav>

        <div class="header-right">
            <div class="mkt-sessions" id="mkt-sessions">
                <div class="ms-item" id="ms-fut" title="CME Futures (Sun 6PM–Fri 5PM ET)">
                    <span class="ms-dot"></span><span class="ms-name">FUT</span>
                </div>
                <div class="ms-sep">·</div>
                <div class="ms-item" id="ms-ny" title="NYSE / NASDAQ (9:30AM–4PM ET)">
                    <span class="ms-dot"></span><span class="ms-name">NY</span>
                </div>
                <div class="ms-sep">·</div>
                <div class="ms-item" id="ms-ldn" title="London LSE (8AM–4:30PM GMT)">
                    <span class="ms-dot"></span><span class="ms-name">LDN</span>
                </div>
                <div class="ms-sep">·</div>
                <div class="ms-item" id="ms-tky" title="Tokyo TSE (9AM–3PM JST)">
                    <span class="ms-dot"></span><span class="ms-name">TKY</span>
                </div>
            </div>
            <div class="tv-ticker-wrap">
                <div class="tradingview-widget-container">
                    <div class="tradingview-widget-container__widget"></div>
                    <script type="text/javascript"
                            src="https://s3.tradingview.com/external-embedding/embed-widget-ticker-tape.js" async>
                                                {
                                                    "symbols": [
                            {"proName": "FOREXCOM:SPXUSD",  "title": "S&P 500"},
                            {"proName": "AMEX:DIA", "title": "Dow (DIA)"},
                            {"proName": "FOREXCOM:NSXUSD",  "title": "Nasdaq"},
                            {"proName": "OANDA:XAUUSD",     "title": "Gold"},
                            {"proName": "TVC:USOIL", "title": "Crude Oil"},
                            {"proName": "BITSTAMP:BTCUSD",  "title": "Bitcoin"}
                        ],
                            "showSymbolLogo": false,
                            "colorTheme": "dark",
                            "isTransparent": true,
                            "displayMode": "compact",
                            "locale": "en"
                        }
                    </script>
                </div>
            </div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <div class="status-bar">
        <div class="status-item"><div class="status-dot"></div> Live</div>
        <div class="status-item">SurePath Markets v1.0</div>
        <div class="status-item" id="status-time"></div>
        <div style="margin-left:auto;" class="status-item">markets.surepath.com</div>
    </div>

    <script src="~/js/markets.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>