<div class="subnav">
    <div class="subnav-left">
        <a class="subnav-item @(ViewData["ActiveNav"]?.ToString() == "journal" ? "active" : "")"
           asp-controller="Trade" asp-action="Journal">
            <span class="dot"></span> Trade Journal
        </a>
        <a class="subnav-item @(ViewData["ActiveNav"]?.ToString() == "riskcalc" ? "active" : "")"
           asp-controller="Trade" asp-action="RiskCalc">
            <span class="dot"></span> Risk Calculator
        </a>
        <a class="subnav-item @(ViewData["ActiveNav"]?.ToString() == "analytics" ? "active" : "")"
           href="#">
            <span class="dot"></span> Analytics
        </a>
    </div>

    <div class="subnav-right">
        @if (User.Identity.IsAuthenticated)
        {
            <span class="subnav-user">👤 @User.Identity.Name</span>
            <form method="post" asp-area="Identity" asp-page="/Account/Logout"
                  asp-route-returnUrl="/Trade/Journal" style="display:inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="subnav-auth-btn subnav-auth-out">Sign Out</button>
            </form>
        }
        else
        {
            <a class="subnav-auth-btn" asp-area="Identity" asp-page="/Account/Login">Sign In</a>
            <a class="subnav-auth-btn subnav-auth-primary" asp-area="Identity" asp-page="/Account/Register">Join Free</a>
        }
    </div>
</div>