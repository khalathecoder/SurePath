@page
@model LoginModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Division"] = "Trading Desk";
}

<div class="auth-page">
    <div class="auth-card fadeup">
        <div class="auth-header">
            <div class="auth-logo">SP</div>
            <div class="auth-title">Welcome back</div>
            <div class="auth-sub">Sign in to your SurePath account</div>
        </div>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="auth-error"></div>

            <div class="auth-field">
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" autocomplete="email" placeholder="you@example.com" />
                <span asp-validation-for="Input.Email" class="auth-field-error"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Input.Password">Password</label>
                <input asp-for="Input.Password" type="password" placeholder="••••••••" />
                <span asp-validation-for="Input.Password" class="auth-field-error"></span>
            </div>

            <div class="auth-remember">
                <label>
                    <input asp-for="Input.RememberMe" type="checkbox" />
                    <span>Remember me</span>
                </label>
            </div>

            <button type="submit" class="auth-submit">Sign In →</button>

            <div class="auth-links">
                <a asp-page="./Register">Create an account</a>
                <a asp-page="./ForgotPassword">Forgot password?</a>
            </div>
        </form>
    </div>
</div>