@page
@model RegisterModel
@{
    ViewData["Title"] = "Create Account";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Division"] = "Trading Desk";
}

<div class="auth-page">
    <div class="auth-card fadeup">
        <div class="auth-header">
            <div class="auth-logo">SP</div>
            <div class="auth-title">Create your account</div>
            <div class="auth-sub">Join SurePath and start tracking your trades</div>
        </div>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="auth-error"></div>

            <div class="auth-field">
                <label asp-for="Input.DisplayName">Display Name</label>
                <input asp-for="Input.DisplayName" placeholder="Your name" />
                <span asp-validation-for="Input.DisplayName" class="auth-field-error"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" autocomplete="email" placeholder="you@example.com" />
                <span asp-validation-for="Input.Email" class="auth-field-error"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Input.Password">Password</label>
                <input asp-for="Input.Password" type="password" placeholder="Min. 8 characters" />
                <span asp-validation-for="Input.Password" class="auth-field-error"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                <input asp-for="Input.ConfirmPassword" type="password" placeholder="••••••••" />
                <span asp-validation-for="Input.ConfirmPassword" class="auth-field-error"></span>
            </div>

            <button type="submit" class="auth-submit">Create Account →</button>

            <div class="auth-links">
                <a asp-page="./Login">Already have an account? Sign in</a>
            </div>
        </form>
    </div>
</div>